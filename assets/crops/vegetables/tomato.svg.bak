<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
  <!-- Tomato body -->
  <circle cx="32" cy="35" r="18" fill="#FF6347" stroke="#DC143C" stroke-width="2"/>
  
  <!-- Tomato highlight -->
  <ellipse cx="28" cy="28" rx="8" ry="10" fill="#FF7F50" opacity="0.6"/>
  
  <!-- Tomato stem -->
  <rect x="30" y="15" width="4" height="8" fill="#228B22" stroke="#006400" stroke-width="1"/>
  
  <!-- Leaves on top -->
  <ellipse cx="25" cy="18" rx="5" ry="3" fill="#228B22" transform="rotate(-30 25 18)"/>
  <ellipse cx="32" cy="16" rx="6" ry="3" fill="#32CD32"/>
  <ellipse cx="39" cy="18" rx="5" ry="3" fill="#228B22" transform="rotate(30 39 18)"/>
  
  <!-- Cute face -->
  <circle cx="26" cy="33" r="2" fill="#000000"/>
  <circle cx="38" cy="33" r="2" fill="#000000"/>
  <path d="M26 40 Q32 44 38 40" stroke="#000000" stroke-width="1.5" fill="none"/>
  
  <!-- Cheeks -->
  <circle cx="20" cy="38" r="3" fill="#FFB6C1" opacity="0.5"/>
  <circle cx="44" cy="38" r="3" fill="#FFB6C1" opacity="0.5"/>
</svg>
